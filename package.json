{
  "name": "minsk-pass-api",
  "version": "1.0.0",
  "description": "Virtual transit card top-up system for Minsk public transport",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
